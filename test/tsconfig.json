{
  "extends": "../tsconfig.json",
  // `../src` is included for tsx's sake: fixture subprocesses resolve this
  // tsconfig from their cwd and only apply it (jsx transform included) to
  // files its `include` matches — src must match or it gets the classic
  // transform. It also pulls in global.d.ts for the JSX intrinsics.
  "include": [".", "../src"],
  "compilerOptions": {
    // Tests index into frames/writes constantly; the churn from
    // `noUncheckedIndexedAccess` isn't worth it outside src.
    "noUncheckedIndexedAccess": false,
    "noPropertyAccessFromIndexSignature": false,
    // Tests import generated `.reference` builds that use enums, and they run
    // through Vitest's transform rather than Node's type stripping.
    "erasableSyntaxOnly": false,
    "paths": {
      "#/*": ["../src/*"]
    }
  }
}
