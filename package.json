{
  "name": "@alchemy.run/sigil",
  "version": "0.1.0",
  "description": "React for CLIs. A self-contained fork of Ink with an integrated TypeScript Yoga layout engine.",
  "keywords": [
    "cli",
    "colors",
    "command-line",
    "components",
    "jsx",
    "preact",
    "print",
    "react",
    "redux",
    "render",
    "stdout",
    "text"
  ],
  "license": "MIT",
  "author": {
    "name": "BlankParticle",
    "email": "blank@alchemy.run",
    "url": "https://blankparticle.com"
  },
  "repository": "alchemy-run/sigil",
  "files": [
    "src",
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "imports": {
    "#/": "./src"
  },
  "exports": {
    "typescript": "./src/index.ts",
    "bun": "./src/index.ts",
    "import": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vp pack -w",
    "build": "vp pack",
    "prepare": "vpr build",
    "test": "vp test",
    "lint": "vp lint",
    "format": "vp fmt .",
    "check": "vp check",
    "typecheck": "tsc --noEmit",
    "inspect": "vpx react-devtools",
    "build:reference": "tsx scripts/build-reference.ts",
    "fuzz": "tsx test/yoga/fuzz/typescript.ts",
    "fuzz:differential": "vpr build:reference && tsx test/yoga/fuzz/differential.ts",
    "fuzz:loop": "vpr build:reference && tsx test/yoga/fuzz/loop.ts"
  },
  "dependencies": {
    "react-reconciler": "^0.33.0",
    "scheduler": "^0.27.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-reconciler": "^0.33.0",
    "@types/scheduler": "^0.26.0",
    "@types/ws": "^8.18.1",
    "boxen": "^8.0.1",
    "node-pty": "^1.2.0-beta.12",
    "react": "^19.2.4",
    "react-devtools-core": "^7.0.1",
    "react-router": "^7.14.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.9",
    "vitest": "4.1.10",
    "ws": "^8.20.0"
  },
  "peerDependencies": {
    "@types/react": ">=19.2.0",
    "react": ">=19.2.0",
    "react-devtools-core": ">=6.1.2",
    "ws": ">=8.20.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "react-devtools-core": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.22.0"
}
