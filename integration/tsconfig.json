{
  "extends": "../tsconfig.json",
  "include": ["src", "scripts", "vite.config.ts"],
  "exclude": ["src/explorer-app"],
  "compilerOptions": {
    // Resolve `@alchemy.run/sigil` to its source, matching how tests and
    // fixtures run.
    "customConditions": ["source"],
    "paths": {
      "#/*": ["../src/*"]
    }
  }
}
